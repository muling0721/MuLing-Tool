<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="网易云歌曲解析"
        android:textAppearance="@style/TextAppearance.MuLing.SectionLabel"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.MuLing.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MuLing.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="搜索歌曲 / 歌手"
                app:placeholderText="例如：晴天"
                android:layout_marginBottom="14dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etKeyword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearch"
                style="@style/Widget.MuLing.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="搜索"
                app:icon="@drawable/ic_search"
                app:iconGravity="textStart" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvNeteaseStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="输入关键词开始搜索，点击结果试听，长按复制直链"
        android:textAppearance="@style/TextAppearance.MuLing.Body"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.MuLing.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSongs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 迷你播放器 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPlayer"
        style="@style/Widget.MuLing.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/ivPlayerCover"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_cover"
                android:clipToOutline="true"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPlayerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.MuLing.RowTitle"
                    android:maxLines="1"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tvPlayerArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.MuLing.RowSubtitle"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_play"
                android:tint="?attr/colorOnSurface"
                android:contentDescription="播放/暂停" />

            <ImageButton
                android:id="@+id/btnCopyUrl"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_copy"
                android:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="复制直链" />

            <ImageButton
                android:id="@+id/btnDownload"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_download"
                android:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="下载" />

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="关闭" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>

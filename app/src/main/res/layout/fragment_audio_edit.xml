<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="剪辑音频"
            android:textAppearance="@style/TextAppearance.MuLing.SectionLabel"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MuLing.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectTrim"
                    style="@style/Widget.MuLing.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选择要剪辑的文件"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvTrimFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="未选择文件"
                    android:textAppearance="@style/TextAppearance.MuLing.Body"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/layoutTrim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="拖拽选择区间"
                        android:textAppearance="@style/TextAppearance.MuLing.SectionLabel"
                        android:layout_marginBottom="8dp" />

                    <com.ncmdump.app.AudioTrimView
                        android:id="@+id/trimView"
                        android:layout_width="match_parent"
                        android:layout_height="88dp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTrim"
                        style="@style/Widget.MuLing.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="开始剪辑" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="合并音频"
            android:textAppearance="@style/TextAppearance.MuLing.SectionLabel"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MuLing.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectMerge"
                    style="@style/Widget.MuLing.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选择要合并的文件（可多选）"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvMergeFiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="未选择文件"
                    android:textAppearance="@style/TextAppearance.MuLing.Body"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMerge"
                    style="@style/Widget.MuLing.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="开始合并" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:trackCornerRadius="4dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="等待操作..."
            android:textAppearance="@style/TextAppearance.MuLing.Body"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>

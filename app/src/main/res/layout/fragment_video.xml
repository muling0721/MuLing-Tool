<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="视频解析"
            android:textAppearance="@style/TextAppearance.MuLing.SectionLabel"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp" />

        <!-- 输入卡片 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MuLing.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MuLing.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="BV 号 / AV 号 / 视频链接"
                    app:placeholderText="BV1xx411c7mD"
                    android:layout_marginBottom="14dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBvid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnParse"
                    style="@style/Widget.MuLing.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="解析" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 状态 -->
        <TextView
            android:id="@+id/tvBiliStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="等待输入..."
            android:textAppearance="@style/TextAppearance.MuLing.Body"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- 视频信息卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVideoInfo"
            style="@style/Widget.MuLing.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivCover"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_cover"
                    android:clipToOutline="true"
                    android:contentDescription="@null"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.MuLing.RowTitle"
                    android:textSize="17sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvOwner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.MuLing.RowSubtitle"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.MuLing.RowSubtitle"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.MuLing.Body"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayInline"
                    style="@style/Widget.MuLing.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="内置播放"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGetPlayUrl"
                    style="@style/Widget.MuLing.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="获取播放地址"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyVideoUrl"
                    style="@style/Widget.MuLing.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="复制视频流地址"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyAudioUrl"
                    style="@style/Widget.MuLing.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="复制音频流地址"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 分P卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPages"
            style="@style/Widget.MuLing.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="分P列表"
                    android:textAppearance="@style/TextAppearance.MuLing.SectionLabel"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvPages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.MuLing.Body"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="工具"
            android:textAppearance="@style/TextAppearance.MuLing.SectionLabel"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MuLing.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 音频解析 -->
                <LinearLayout
                    android:id="@+id/menuParse"
                    style="@style/Widget.MuLing.ListRow">

                    <ImageView
                        style="@style/Widget.MuLing.IconBadge"
                        android:src="@drawable/ic_audio"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="音频解析"
                            android:textAppearance="@style/TextAppearance.MuLing.RowTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="网易云 NCM 格式解密"
                            android:textAppearance="@style/TextAppearance.MuLing.RowSubtitle"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_forward"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="@null" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="72dp"
                    android:background="?attr/colorOutlineVariant" />

                <!-- 音频转换 -->
                <LinearLayout
                    android:id="@+id/menuConvert"
                    style="@style/Widget.MuLing.ListRow">

                    <ImageView
                        style="@style/Widget.MuLing.IconBadge"
                        android:src="@drawable/ic_convert"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="音频转换"
                            android:textAppearance="@style/TextAppearance.MuLing.RowTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="任意格式互转，支持码率选择"
                            android:textAppearance="@style/TextAppearance.MuLing.RowSubtitle"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_forward"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="@null" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="72dp"
                    android:background="?attr/colorOutlineVariant" />

                <!-- 网易云歌曲解析 -->
                <LinearLayout
                    android:id="@+id/menuNetease"
                    style="@style/Widget.MuLing.ListRow">

                    <ImageView
                        style="@style/Widget.MuLing.IconBadge"
                        android:src="@drawable/ic_search"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="网易云歌曲解析"
                            android:textAppearance="@style/TextAppearance.MuLing.RowTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="在线搜索 / 试听 / 复制直链 / 下载"
                            android:textAppearance="@style/TextAppearance.MuLing.RowSubtitle"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_forward"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
